# Copia este archivo como .env y rellena los valores.
# .env nunca se sube al repositorio. Variables descritas en la spec §1.9.

# --- Nivel Esencial ---
# Ruta del modelo. Ejemplo: models/best.pt (desde el nivel Medio: models/best.onnx)
MODEL_PATH=
# Confianza mínima para aceptar una detección. Ejemplo: 0.5
CONFIDENCE_THRESHOLD=

# --- Nivel Medio ---
# Fotogramas analizados por segundo de vídeo. Ejemplo: 5
SAMPLE_FPS=

# --- Nivel Avanzado ---
# Conexión a PostgreSQL (secreto). Ejemplo: postgresql://usuario:contraseña@localhost:5432/background_buzz
DATABASE_URL=
# Carpeta local de los recortes. Ejemplo: data/crops
CROPS_DIR=

# --- Nivel Experto ---
# URL de best.onnx en la GitHub Release (la usa el Dockerfile)
MODEL_URL=
# Tamaño máximo del vídeo en MB. Ejemplo: 50
MAX_UPLOAD_MB=
# Duración máxima del vídeo en segundos. Ejemplo: 30
MAX_DURATION_S=
# Orígenes permitidos por CORS. Ejemplo: http://localhost:5173
CORS_ORIGINS=
# Supabase: URL del proyecto, clave (secreto) y bucket de los recortes
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# VITE_API_URL va en frontend/.env (se crea en T-4.4).
